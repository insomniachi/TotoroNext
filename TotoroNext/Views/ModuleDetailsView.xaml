<UserControl
    x:Class="TotoroNext.Views.ModuleDetailsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:a="using:TotoroNext.Anime"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:TotoroNext.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="300"
    d:DesignWidth="400"
    mc:Ignorable="d">

    <Grid Padding="16" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <Image Source="{x:Bind a:Converters.StringToImage(ViewModel.Manifest.ImageUrl), Mode=OneWay}" Stretch="UniformToFill" />

        <StackPanel Grid.Row="1" Spacing="8">
            <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="{x:Bind ViewModel.Manifest.Name, Mode=OneWay}" />
            <Button
                HorizontalAlignment="Stretch"
                Command="{x:Bind ViewModel.DownloadCommand}"
                CommandParameter="{x:Bind ViewModel.Manifest, Mode=OneWay}"
                Visibility="{x:Bind a:Converters.BooleanToVisibility(ViewModel.CanDownload), Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE896;" />
                    <TextBlock Text="{x:Bind ViewModel.DownloadButtonText, Mode=OneWay}" />
                </StackPanel>
            </Button>
            <!--<ProgressBar IsIndeterminate="True" Visibility="{x:Bind a:Converters.BooleanToVisibility(ViewModel.IsDownloading), Mode=OneWay}" />-->
            <TextBlock Text="{x:Bind ViewModel.Manifest.Description, Mode=OneWay}" TextWrapping="WrapWholeWords" />
        </StackPanel>
    </Grid>
</UserControl>
