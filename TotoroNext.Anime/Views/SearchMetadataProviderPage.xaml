<Page
    x:Class="TotoroNext.Anime.Views.SearchMetadataProviderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:TotoroNext.Anime.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:root="using:TotoroNext.Anime"
    xmlns:taa="using:TotoroNext.Anime.Abstractions"
    xmlns:uc="using:TotoroNext.Anime.UserControls"
    mc:Ignorable="d">

    <SplitView
        x:Name="SplitView"
        DisplayMode="Inline"
        PanePlacement="Right">
        <Grid Margin="36" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <AutoSuggestBox
                PlaceholderText="Search"
                QueryIcon="Find"
                Text="{x:Bind ViewModel.Query, Mode=TwoWay}" />

            <ScrollView Grid.Row="1" Tapped="BackgroundTapped">
                <ItemsRepeater
                    Grid.Row="1"
                    ElementPrepared="ItemsRepeater_ElementPrepared"
                    ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}">
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="taa:AnimeModel">
                            <ItemContainer>
                                <uc:AnimeCard
                                    Anime="{x:Bind}"
                                    IsRightTapEnabled="True"
                                    IsTapEnabled="True"
                                    RightTapped="AnimeCard_RightTapped"
                                    Tapped="AnimeCard_Tapped" />
                            </ItemContainer>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                    <ItemsRepeater.Layout>
                        <UniformGridLayout
                            ItemsJustification="Start"
                            ItemsStretch="Fill"
                            MinColumnSpacing="16"
                            MinItemHeight="400"
                            MinItemWidth="250"
                            MinRowSpacing="16" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </ScrollView>

        </Grid>
    </SplitView>
</Page>
