<UserControl
    x:Class="TotoroNext.Anime.Views.AnimeSongsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:a="using:TotoroNext.Anime"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:TotoroNext.Anime.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:taa="using:TotoroNext.Anime.Abstractions"
    xmlns:utu="using:Uno.Toolkit.UI"
    d:DesignHeight="300"
    d:DesignWidth="400"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <MediaPlayerElement
            Grid.Row="0"
            AreTransportControlsEnabled="True"
            AutoPlay="True"
            Source="{x:Bind local:AnimeSongsView.GetVideoSource(ViewModel.SelectedTheme), Mode=OneWay}"
            Visibility="{x:Bind a:Converters.ObjectToVisiblity(ViewModel.SelectedTheme), Mode=OneWay}">
            <MediaPlayerElement.TransportControls>
                <MediaTransportControls IsCompact="True" />
            </MediaPlayerElement.TransportControls>
        </MediaPlayerElement>

        <ScrollView Grid.Row="1">
            <ItemsRepeater Margin="0,4,0,0" ItemsSource="{x:Bind ViewModel.Themes, Mode=OneWay}">
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="taa:AnimeTheme">
                        <Grid
                            Margin="0,4"
                            Padding="16"
                            Background="{ThemeResource SmokeFillColorDefaultBrush}"
                            ColumnSpacing="8"
                            CornerRadius="{StaticResource ControlCornerRadius}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="{x:Bind DisplayName}" />
                            <Button
                                Grid.Column="1"
                                Command="{utu:AncestorBinding AncestorType=ItemsRepeater,
                                                              Path=DataContext.PlayCommand}"
                                CommandParameter="{x:Bind}"
                                ToolTipService.ToolTip="Play Video">
                                <FontIcon Glyph="&#xE8B2;" />
                            </Button>
                            <Button
                                Grid.Column="2"
                                Command="{utu:AncestorBinding AncestorType=ItemsRepeater,
                                                              Path=DataContext.PlayAudioCommand}"
                                CommandParameter="{x:Bind}"
                                ToolTipService.ToolTip="Play Audio">
                                <FontIcon Glyph="&#xE8D6;" />
                            </Button>
                            <Button
                                Grid.Column="3"
                                Command="{utu:AncestorBinding AncestorType=ItemsRepeater,
                                                              Path=DataContext.OpenInMediaPlayerCommand}"
                                CommandParameter="{x:Bind}"
                                ToolTipService.ToolTip="Open in External Media player">
                                <FontIcon Glyph="&#xE8A7;" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

        </ScrollView>

    </Grid>
</UserControl>
