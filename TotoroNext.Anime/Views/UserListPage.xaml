<Page
    x:Class="TotoroNext.Anime.Views.UserListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctk="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:TotoroNext.Anime.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:root="using:TotoroNext.Anime"
    xmlns:taa="using:TotoroNext.Anime.Abstractions"
    xmlns:tc="using:TotoroNext.Module.Controls"
    xmlns:uc="using:TotoroNext.Anime.UserControls"
    xmlns:utu="using:Uno.Toolkit.UI"
    mc:Ignorable="d">

    <Grid Margin="36" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel
            HorizontalAlignment="Center"
            Orientation="Horizontal"
            Spacing="32">
            <utu:ChipGroup
                ItemsSource="{x:Bind ViewModel.AllStatus, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.Filter.Status, Mode=TwoWay}"
                SelectionMode="Single">
                <utu:ChipGroup.ItemTemplate>
                    <DataTemplate x:DataType="taa:ListItemStatus">
                        <TextBlock
                            Width="200"
                            Style="{ThemeResource SubtitleTextBlockStyle}"
                            Text="{x:Bind root:Converters.EnumToDescription((taa:ListItemStatus))}"
                            TextAlignment="Center" />
                    </DataTemplate>
                </utu:ChipGroup.ItemTemplate>
                <utu:ChipGroup.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </utu:ChipGroup.ItemsPanel>
            </utu:ChipGroup>

            <SplitButton Height="38" Command="{x:Bind ViewModel.OpenFilterPaneCommand}">
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <FontIcon Glyph="&#xE71C;" />
                    <TextBlock Text="Filter" />
                </StackPanel>
                <SplitButton.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Command="{x:Bind ViewModel.ClearFiltersCommand}" Text="Clear Filters">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE894;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </SplitButton.Flyout>
            </SplitButton>
        </StackPanel>

        <ctk:SwitchPresenter
            Grid.Row="1"
            TargetType="x:Boolean"
            Value="{x:Bind ViewModel.IsLoading, Mode=OneWay}">
            <ctk:Case Value="True">
                <Grid>
                    <ProgressRing
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsIndeterminate="True" />
                </Grid>
            </ctk:Case>
            <ctk:Case Value="False">
                <ScrollView Background="Transparent" Tapped="BackgroundTapped">
                    <Grid>
                        <Rectangle
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Fill="Transparent" />
                        <ItemsRepeater ElementPrepared="AnimeList_ElementPrepared" ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}">
                            <ItemsRepeater.ItemTransitionProvider>
                                <LinedFlowLayoutItemCollectionTransitionProvider />
                            </ItemsRepeater.ItemTransitionProvider>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="taa:AnimeModel">
                                    <ItemContainer>
                                        <uc:AnimeCard
                                            Anime="{x:Bind}"
                                            IsRightTapEnabled="True"
                                            IsTapEnabled="True"
                                            RightTapped="AnimeCard_RightTapped"
                                            Tapped="AnimeCard_Tapped" />
                                    </ItemContainer>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                            <ItemsRepeater.Layout>
                                <UniformGridLayout
                                    ItemsJustification="Start"
                                    ItemsStretch="Fill"
                                    MinColumnSpacing="16"
                                    MinItemHeight="400"
                                    MinItemWidth="250"
                                    MinRowSpacing="16" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                    </Grid>
                </ScrollView>
            </ctk:Case>
        </ctk:SwitchPresenter>
    </Grid>
</Page>
