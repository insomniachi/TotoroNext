<UserControl
    x:Class="TotoroNext.Anime.Views.AnimeOverridesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctk="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:TotoroNext.Anime.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="300"
    d:DesignWidth="400"
    mc:Ignorable="d">

    <StackPanel>
        <ctk:SettingsCard Description="Modules can decide what to do with this. Eg: Discord will not show rich presence" Header="Is NSFW">
            <ctk:SettingsCard.HeaderIcon>
                <FontIcon Glyph="&#xED1A;" />
            </ctk:SettingsCard.HeaderIcon>
            <ToggleSwitch IsOn="{x:Bind ViewModel.IsNsfw, Mode=TwoWay}" />
        </ctk:SettingsCard>
        <ctk:SettingsCard Description="Overrides the default provider" Header="Provider">
            <ctk:SettingsCard.HeaderIcon>
                <FontIcon Glyph="&#xE7F4;" />
            </ctk:SettingsCard.HeaderIcon>
            <ComboBox
                DisplayMemberPath="Name"
                ItemsSource="{x:Bind ViewModel.Providers, Mode=OneWay}"
                SelectedValue="{x:Bind ViewModel.ProviderId, Mode=TwoWay}"
                SelectedValuePath="Id" />
        </ctk:SettingsCard>
    </StackPanel>
</UserControl>
