<UserControl
    x:Class="TotoroNext.Anime.Views.UserListFilterView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:TotoroNext.Anime.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mod="using:TotoroNext.Module"
    d:DesignHeight="300"
    d:DesignWidth="400"
    mod:NavigationExtensions.PaneWidth="500"
    mc:Ignorable="d">

    <Grid>
        <StackPanel Padding="16" Spacing="16">
            <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="Filter" />
            <AutoSuggestBox PlaceholderText="Name" Text="{x:Bind ViewModel.Filter.Term, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" >
                <AutoSuggestBox.QueryIcon>
                    <FontIcon Glyph="&#xE8AC;" />
                </AutoSuggestBox.QueryIcon>
            </AutoSuggestBox>
            <AutoSuggestBox PlaceholderText="Year" Text="{x:Bind ViewModel.Filter.Year, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                <AutoSuggestBox.QueryIcon>
                    <FontIcon Glyph="&#xE787;" />
                </AutoSuggestBox.QueryIcon>
            </AutoSuggestBox>
        </StackPanel>
    </Grid>
</UserControl>
