<UserControl
    x:Class="TotoroNext.Anime.Views.AnimeDetailsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctk="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:TotoroNext.Anime"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mod="using:TotoroNext.Module"
    xmlns:taa="using:TotoroNext.Anime.Abstractions.Models"
    xmlns:utu="using:Uno.Toolkit.UI"
    d:DesignHeight="300"
    d:DesignWidth="400"
    mod:NavigationExtensions.PaneWidth="750"
    mc:Ignorable="d">

    <Grid Padding="16" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition MaxHeight="435" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <TextBlock
            Margin="0,0,0,8"
            Style="{ThemeResource TitleTextBlockStyle}"
            Text="{x:Bind ViewModel.Anime.Title}" />

        <Grid Grid.Row="1" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1.25*" />
            </Grid.ColumnDefinitions>

            <Border CornerRadius="{ThemeResource ControlCornerRadius}">
                <Image Source="{x:Bind ViewModel.Anime.Image}" />
            </Border>

            <Grid
                Grid.Column="1"
                ColumnSpacing="16"
                RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Text="Status" />
                <ComboBox
                    Grid.Row="0"
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    ItemsSource="{x:Bind ViewModel.Statuses}"
                    SelectedItem="{x:Bind ViewModel.Status, Mode=TwoWay}" />

                <TextBlock
                    Grid.Row="1"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Text="Progress" />
                <NumberBox
                    Grid.Row="1"
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    LargeChange="1"
                    SmallChange="1"
                    SpinButtonPlacementMode="Inline"
                    Value="{x:Bind ViewModel.Progress, Mode=TwoWay}" />

                <TextBlock
                    Grid.Row="2"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Text="Score" />
                <NumberBox
                    Grid.Row="2"
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    LargeChange="1"
                    Maximum="10"
                    Minimum="0"
                    SmallChange="1"
                    Value="{x:Bind ViewModel.Score, Mode=TwoWay}" />

                <TextBlock
                    Grid.Row="3"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Text="Start Date" />
                <DatePicker
                    Grid.Row="3"
                    Grid.Column="1"
                    SelectedDate="{x:Bind ViewModel.StartDate, Mode=TwoWay}" />

                <TextBlock
                    Grid.Row="4"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Text="Finish Date" />
                <DatePicker
                    Grid.Row="4"
                    Grid.Column="1"
                    SelectedDate="{x:Bind ViewModel.FinishDate, Mode=TwoWay}" />

                <Button
                    x:Name="ContinueWatchingButton"
                    Grid.Row="5"
                    Grid.ColumnSpan="2"
                    HorizontalAlignment="Center"
                    Command="{x:Bind ViewModel.ContinueWatchingCommand}"
                    Visibility="{x:Bind local:Converters.BooleanToVisibility(ContinueWatchingButton.IsEnabled), Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Play" />
                        <TextBlock Text="Watch" />
                    </StackPanel>
                </Button>

                <ScrollView
                    Grid.Row="6"
                    Grid.ColumnSpan="2"
                    Margin="0,8,0,0"
                    HorizontalScrollMode="Disabled">
                    <TextBlock Text="{x:Bind ViewModel.Anime.Description, Mode=OneWay}" TextWrapping="Wrap" />
                </ScrollView>

            </Grid>
        </Grid>

        <SelectorBar x:Name="Pivot" Grid.Row="2">
            <SelectorBarItem
                FontSize="25"
                FontWeight="SemiLight"
                IsSelected="True"
                Text="Episodes" />
        </SelectorBar>

        <ctk:SwitchPresenter Grid.Row="3" Value="{x:Bind Pivot.SelectedItem.Text, Mode=OneWay}">
            <ctk:Case Value="Episodes">
                <ItemsView
                    IsItemInvokedEnabled="True"
                    ItemInvoked="ItemsView_ItemInvoked"
                    ItemsSource="{x:Bind ViewModel.Episodes, Mode=OneWay}"
                    SelectionMode="None">
                    <ItemsView.ItemTemplate>
                        <DataTemplate x:DataType="taa:EpisodeInfo">
                            <ItemContainer Height="160" Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Image Source="{x:Bind Image}" Stretch="Uniform" />

                                    <Grid Grid.Column="1" Padding="10">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Margin="0,0,0,8" Style="{ThemeResource SubtitleTextBlockStyle}">
                                            <Run Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="Episode" />
                                            <Run Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="{x:Bind EpisodeNumber}" />
                                            <Run Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text=":" />
                                            <Run Text="{x:Bind Titles.English}" />
                                        </TextBlock>
                                        <StackPanel
                                            Grid.Row="1"
                                            Margin="0,0,0,8"
                                            Orientation="Horizontal"
                                            Spacing="5">
                                            <SymbolIcon Symbol="CalendarDay" />
                                            <TextBlock Margin="0,0,16,0" Text="{x:Bind AirDate}" />
                                            <SymbolIcon Symbol="Clock" />
                                            <TextBlock>
                                                <Run Text="{x:Bind Runtime}" />
                                                <Run Text="Min" />
                                            </TextBlock>
                                        </StackPanel>
                                        <ScrollView Grid.Row="2">
                                            <TextBlock
                                                Style="{ThemeResource BodyTextBlockStyle}"
                                                Text="{x:Bind Overview}"
                                                TextWrapping="WrapWholeWords" />
                                        </ScrollView>
                                    </Grid>
                                </Grid>
                            </ItemContainer>
                        </DataTemplate>
                    </ItemsView.ItemTemplate>
                    <ItemsView.Layout>
                        <StackLayout Spacing="8" />
                    </ItemsView.Layout>
                </ItemsView>
            </ctk:Case>
            <ctk:Case IsDefault="True" />
        </ctk:SwitchPresenter>

    </Grid>
</UserControl>
