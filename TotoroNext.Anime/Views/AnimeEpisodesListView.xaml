<UserControl
    x:Class="TotoroNext.Anime.Views.AnimeEpisodesListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:TotoroNext.Anime"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mod="using:TotoroNext.Module"
    xmlns:taa="using:TotoroNext.Anime.Abstractions.Models"
    xmlns:utu="using:Uno.Toolkit.UI"
    d:DesignHeight="300"
    d:DesignWidth="400"
    mc:Ignorable="d">

    <utu:LoadingView Source="{x:Bind ViewModel.InitializeAction, Mode=OneWay}">
        <utu:LoadingView.LoadingContent>
            <Grid>
                <ProgressRing
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsIndeterminate="True" />
            </Grid>
        </utu:LoadingView.LoadingContent>
        <utu:LoadingView.Content>
            <ItemsView
                mod:ItemsViewSelectionHelper.Command="{x:Bind ViewModel.WatchEpisodeCommand}"
                mod:ItemsViewSelectionHelper.EnableSelectionTracking="True"
                mod:ItemsViewSelectionHelper.SelectedItem="{x:Bind ViewModel.SelectedEpisode, Mode=TwoWay}"
                IsItemInvokedEnabled="True"
                ItemsSource="{x:Bind ViewModel.Episodes, Mode=OneWay}"
                SelectionMode="Single">
                <ItemsView.ItemTemplate>
                    <DataTemplate x:DataType="taa:EpisodeInfo">
                        <ItemContainer Height="160" Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Grid>
                                    <Image Source="{x:Bind local:Converters.StringToImage(Image)}" Stretch="Uniform" />
                                    <ProgressBar
                                        Grid.Row="3"
                                        Margin="8"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Bottom"
                                        Foreground="Green"
                                        Maximum="{x:Bind Progress.Total}"
                                        Visibility="{x:Bind local:Converters.ObjectToVisiblity(Progress)}"
                                        Value="{x:Bind Progress.Position}" />
                                </Grid>


                                <Grid Grid.Column="1" Padding="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock
                                        Margin="0,0,0,8"
                                        Style="{ThemeResource SubtitleTextBlockStyle}"
                                        TextTrimming="WordEllipsis"
                                        TextWrapping="NoWrap">
                                        <Run Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="Episode" />
                                        <Run Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="{x:Bind EpisodeNumber}" />
                                        <Run Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text=":" />
                                        <Run Text="{x:Bind Titles.English}" />
                                    </TextBlock>
                                    <StackPanel
                                        Grid.Row="1"
                                        Margin="0,0,0,8"
                                        Orientation="Horizontal"
                                        Spacing="5">
                                        <SymbolIcon Symbol="CalendarDay" />
                                        <TextBlock Margin="0,0,16,0" Text="{x:Bind AirDate}" />
                                        <SymbolIcon Symbol="Clock" />
                                        <TextBlock>
                                            <Run Text="{x:Bind Runtime}" />
                                            <Run Text="Min" />
                                        </TextBlock>
                                    </StackPanel>
                                    <ScrollView Grid.Row="2">
                                        <TextBlock
                                            Style="{ThemeResource BodyTextBlockStyle}"
                                            Text="{x:Bind Overview}"
                                            TextWrapping="WrapWholeWords" />
                                    </ScrollView>
                                </Grid>
                            </Grid>
                        </ItemContainer>
                    </DataTemplate>
                </ItemsView.ItemTemplate>
                <ItemsView.Layout>
                    <StackLayout Spacing="8" />
                </ItemsView.Layout>
            </ItemsView>
        </utu:LoadingView.Content>
    </utu:LoadingView>
</UserControl>
